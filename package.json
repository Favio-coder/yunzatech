{
  "name": "yunzatech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:backend": "node scripts/deno.js task --cwd backend check",
    "test": "node scripts/deno.js task --cwd backend test",
    "backend": "node scripts/deno.js task --cwd backend dev",
    "emulators": "node scripts/firebase.js emulators:start --project demo-yunza-tech --only auth,firestore",
    "test:integration": "node tests/run-integration.js",
    "test:emulators": "node scripts/firebase.js emulators:exec --project demo-yunza-tech --only auth,firestore \"node tests/run-integration.js\"",
    "format": "prettier --write src backend scripts tests *.js *.json index.html README.md",
    "format:check": "prettier --check src backend scripts tests *.js *.json index.html README.md"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
